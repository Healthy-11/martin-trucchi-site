---
/**
 * Interactive digit distribution visualizer.
 * Shows how digits of pi, e, sqrt(2) distribute — core to Martin's research.
 * Pure vanilla JS + Canvas, no external dependencies.
 */
---

<div class="demo-container" id="digit-demo">
    <div class="demo-controls">
        <label>
            <span>Number:</span>
            <select id="demo-number">
                <option value="pi" selected>π (pi)</option>
                <option value="e">e (Euler's number)</option>
                <option value="sqrt2">√2</option>
                <option value="phi">φ (golden ratio)</option>
            </select>
        </label>
        <label>
            <span>Digits:</span>
            <input type="range" id="demo-digits" min="10" max="1000" value="100" />
            <span id="demo-digits-val">100</span>
        </label>
        <button id="demo-animate" class="demo-btn">Animate</button>
    </div>
    <canvas id="demo-canvas" width="700" height="320"></canvas>
    <p class="demo-caption" id="demo-caption">
        Distribution of the first 100 digits of π. A perfectly normal number would show equal bars.
    </p>
</div>

<style>
    .demo-container {
        padding: 1.5rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 12px;
        margin: 2rem 0;
    }

    .demo-controls {
        display: flex;
        gap: 1.25rem;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .demo-controls label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .demo-controls select,
    .demo-controls input[type="range"] {
        accent-color: var(--accent);
    }

    .demo-controls select {
        padding: 0.3rem 0.5rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--bg-primary);
        color: var(--text-primary);
        font-family: inherit;
        font-size: 0.85rem;
    }

    .demo-btn {
        padding: 0.35rem 0.9rem;
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 0.85rem;
        font-family: inherit;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .demo-btn:hover { background: var(--accent-hover); }

    #demo-canvas {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 8px;
    }

    .demo-caption {
        font-size: 0.825rem;
        color: var(--text-tertiary);
        margin-top: 0.75rem;
        text-align: center;
        font-style: italic;
    }

    #demo-digits-val {
        min-width: 2.5rem;
        text-align: right;
        font-variant-numeric: tabular-nums;
    }
</style>

<script>
    function initDemo() {
        const canvas = document.getElementById('demo-canvas') as HTMLCanvasElement;
        const ctx = canvas?.getContext('2d');
        if (!canvas || !ctx) return;

        const selectNum = document.getElementById('demo-number') as HTMLSelectElement;
        const sliderDigits = document.getElementById('demo-digits') as HTMLInputElement;
        const digitsVal = document.getElementById('demo-digits-val')!;
        const animateBtn = document.getElementById('demo-animate')!;
        const caption = document.getElementById('demo-caption')!;

        // First 1000 digits of each constant (after decimal point)
        const DIGITS: Record<string, string> = {
            pi: '',
            e: '',
            sqrt2: '',
            phi: '',
        };

        const LABELS: Record<string, string> = {
            pi: 'π', e: 'e', sqrt2: '√2', phi: 'φ'
        };

        let animationId: number | null = null;

        function getDigits(name: string, count: number): number[] {
            const str = DIGITS[name] || DIGITS.pi;
            return str.slice(0, count).split('').map(Number);
        }

        function countDigits(digits: number[]): number[] {
            const counts = new Array(10).fill(0);
            digits.forEach((d) => counts[d]++);
            return counts;
        }

        function draw(counts: number[], total: number, label: string) {
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            ctx.scale(dpr, dpr);

            const w = rect.width;
            const h = rect.height;

            // Get theme colors
            const style = getComputedStyle(document.documentElement);
            const bgColor = style.getPropertyValue('--bg-secondary').trim();
            const textColor = style.getPropertyValue('--text-primary').trim();
            const textTertiary = style.getPropertyValue('--text-tertiary').trim();
            const accent = style.getPropertyValue('--accent').trim();
            const border = style.getPropertyValue('--border').trim();

            ctx.clearRect(0, 0, w, h);

            const padding = { top: 30, right: 20, bottom: 40, left: 45 };
            const chartW = w - padding.left - padding.right;
            const chartH = h - padding.top - padding.bottom;
            const barW = chartW / 10;
            const maxCount = Math.max(...counts, 1);
            const expected = total / 10;

            // Draw expected line
            const expectedY = padding.top + chartH - (expected / maxCount) * chartH;
            ctx.strokeStyle = textTertiary;
            ctx.lineWidth = 1;
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.moveTo(padding.left, expectedY);
            ctx.lineTo(w - padding.right, expectedY);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.fillStyle = textTertiary;
            ctx.font = '11px system-ui, sans-serif';
            ctx.textAlign = 'right';
            ctx.fillText(`expected: ${(expected).toFixed(1)}`, w - padding.right, expectedY - 5);

            // Draw bars
            counts.forEach((count, i) => {
                const barH = (count / maxCount) * chartH;
                const x = padding.left + i * barW + barW * 0.15;
                const y = padding.top + chartH - barH;
                const bw = barW * 0.7;

                ctx.fillStyle = accent;
                ctx.globalAlpha = 0.85;
                ctx.beginPath();
                ctx.roundRect(x, y, bw, barH, [4, 4, 0, 0]);
                ctx.fill();
                ctx.globalAlpha = 1;

                // Count label
                ctx.fillStyle = textColor;
                ctx.font = '12px system-ui, sans-serif';
                ctx.textAlign = 'center';
                if (count > 0) {
                    ctx.fillText(String(count), x + bw / 2, y - 6);
                }

                // Digit label
                ctx.fillStyle = textTertiary;
                ctx.fillText(String(i), x + bw / 2, padding.top + chartH + 20);
            });

            // Y-axis label
            ctx.save();
            ctx.translate(12, padding.top + chartH / 2);
            ctx.rotate(-Math.PI / 2);
            ctx.fillStyle = textTertiary;
            ctx.font = '11px system-ui, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('count', 0, 0);
            ctx.restore();

            // X-axis label
            ctx.fillStyle = textTertiary;
            ctx.font = '11px system-ui, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('digit', padding.left + chartW / 2, h - 5);
        }

        function update() {
            const name = selectNum.value;
            const count = parseInt(sliderDigits.value);
            digitsVal.textContent = String(count);
            const digits = getDigits(name, count);
            const counts = countDigits(digits);
            draw(counts, digits.length, LABELS[name]);
            caption.textContent = `Distribution of the first ${count} digits of ${LABELS[name]}. A perfectly normal number would show equal bars.`;
        }

        function animate() {
            if (animationId) {
                cancelAnimationFrame(animationId);
                animationId = null;
            }

            const name = selectNum.value;
            const target = parseInt(sliderDigits.value);
            let current = 0;

            function step() {
                current = Math.min(current + Math.max(1, Math.floor(target / 60)), target);
                sliderDigits.value = String(current);
                digitsVal.textContent = String(current);
                const digits = getDigits(name, current);
                const counts = countDigits(digits);
                draw(counts, digits.length, LABELS[name]);
                caption.textContent = `Distribution of the first ${current} digits of ${LABELS[name]}. A perfectly normal number would show equal bars.`;

                if (current < target) {
                    animationId = requestAnimationFrame(step);
                } else {
                    animationId = null;
                }
            }
            step();
        }

        selectNum.addEventListener('change', update);
        sliderDigits.addEventListener('input', update);
        animateBtn.addEventListener('click', () => {
            sliderDigits.value = '1000';
            animate();
        });

        // Handle resize
        const observer = new ResizeObserver(() => update());
        observer.observe(canvas);

        update();
    }

    document.addEventListener('astro:page-load', initDemo);
</script>
