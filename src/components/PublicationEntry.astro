---
interface Props {
    id: string;
    title: string;
    authors: string;
    venue: string;
    abstract?: string;
    bibtex?: string;
    links?: { label: string; url: string }[];
}

const { id, title, authors, venue, abstract, bibtex, links = [] } = Astro.props;
---

<div class="pub-entry reveal-right">
    <h3>{title}</h3>
    <p class="pub-authors">{authors}</p>
    <p class="pub-venue">{venue}</p>

    <div class="pub-actions">
        <div class="pub-links">
            {links.map(({ label, url }) => (
                <a href={url} target="_blank" rel="noopener noreferrer">{label}</a>
            ))}
        </div>

        {abstract && (
            <button class="pub-toggle" data-target={`abstract-${id}`}>
                Abstract
            </button>
        )}

        {bibtex && (
            <button class="pub-toggle" data-target={`bibtex-${id}`}>
                BibTeX
            </button>
        )}
    </div>

    {abstract && (
        <div id={`abstract-${id}`} class="pub-expandable">
            <div class="pub-abstract">{abstract}</div>
        </div>
    )}

    {bibtex && (
        <div id={`bibtex-${id}`} class="pub-expandable">
            <div class="pub-bibtex">
                <button class="copy-btn">Copy</button>
                <pre><code>{bibtex}</code></pre>
            </div>
        </div>
    )}
</div>
