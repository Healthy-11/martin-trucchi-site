---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Martin Trucchi" description="The page you're looking for doesn't exist.">
    <div class="page-header" style="text-align: center; padding: 5rem 0 4rem;">
        <div class="container">
            <h1 style="font-size: 6rem; margin-bottom: 0.25rem; color: var(--accent);">404</h1>
            <p style="font-size: 1.25rem; color: var(--text-secondary); margin-bottom: 2rem;">
                This page doesn't exist. It might have been moved, or it never existed.
            </p>
            <a href="/" style="display: inline-block; padding: 0.65rem 1.5rem; background: var(--accent); color: white; border-radius: 8px; font-weight: 500; transition: background-color 0.2s ease;">
                Back to Home
            </a>
        </div>
    </div>
</BaseLayout>
